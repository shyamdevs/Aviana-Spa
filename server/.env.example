# Aviana Backend Environment
# Local: copy this file to server/.env.  Vercel: add the same keys under Project > Settings > Environment Variables.
NODE_ENV=development
PORT=5000

# Exact frontend origin(s), no trailing slash, comma-separated. This MUST match the address shown
# in the browser for the frontend (for example https://aviana-spa.vercel.app).
CLIENT_URL=http://localhost:5173
# Optional extra origins (preview deployments). "*" is allowed inside the host,
# e.g. https://aviana-spa-*.vercel.app
ALLOWED_ORIGINS=

MONGO_URI=your_mongodb_connection_string

# Use long random values (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_TTL=7d
ADMIN_JWT_SECRET=replace_with_a_long_random_admin_secret
# HMAC key for OTP / challenge hashing and audit identifiers. Must differ from every JWT secret.
OTP_HMAC_SECRET=replace_with_a_long_random_otp_secret
# Versioned AES-256-GCM keys for TOTP secrets: "<id>:<base64 of 32 random bytes>", comma-separated.
# Generate: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
# Rotation: add a new id, set DATA_ENCRYPTION_ACTIVE_KEY to it, keep the old key until re-encrypted.
DATA_ENCRYPTION_KEYS=1:replace_with_base64_32_byte_key
DATA_ENCRYPTION_ACTIVE_KEY=1
BCRYPT_COST=12
# Admin session policy (minutes of inactivity / hours absolute). Optional alert mailbox for security events.
ADMIN_SESSION_IDLE_MINUTES=20
ADMIN_SESSION_HOURS=4
ADMIN_NOTIFY_EMAIL=
# Mobile OTP is NOT active. Leave false unless an SMS provider module has been added and approved.
REQUIRE_PHONE_VERIFICATION=false
SMS_PROVIDER=

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=Aviana Spa <your_email@gmail.com>

GOOGLE_CLIENT_ID=

# Required on Vercel (the filesystem is read-only) if admins upload images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ai add 
# --- Aviana Care (AI customer care). Server-side only: never put these in a VITE_ variable.
GEMINI_API_KEY=
# Use an explicit, supported model id. Do NOT use a "-latest" alias (can silently switch to a slower
# thinking model) or any gemini-2.5-* model (scheduled for shutdown 2026-10-16).
GEMINI_MODEL=gemini-3.5-flash-lite
CUSTOMER_CARE_EMAIL=example@gmail.com

# Optional tuning (defaults shown). All values are range-checked at startup.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest  # tried in order if GEMINI_MODEL is unknown/retired/over quota ('' = none)
# GEMINI_THINKING_LEVEL=minimal      # minimal|low|medium|high|off. Auto = minimal for Gemini 3 / -latest models
# AI_TEMPERATURE=                    # leave unset: Gemini 3 is tuned for its default (1.0)
# AI_REQUEST_TIMEOUT_MS=12000        # per Gemini attempt (2000-30000)
# AI_TOTAL_DEADLINE_MS=20000         # whole request incl. retries/fallbacks; keep BELOW your Vercel function limit
# AI_MAX_RETRIES=1                   # transient errors only (0-2)
# AI_MAX_OUTPUT_TOKENS=1024          # thinking + answer share this; do not set too low
# AI_MAX_CONCURRENT=6                # simultaneous Gemini calls per serverless instance
# AI_DAILY_REQUEST_BUDGET=3000       # shared daily Gemini-call cap across instances (0 = off)
# AI_CATALOG_CACHE_TTL_SECONDS=60    # max staleness of service data on other instances
# CHAT_MAX_MESSAGE_CHARS=1000
# CHAT_CONTEXT_MESSAGES=8            # recent turns sent to Gemini
# CHAT_MAX_STORED_MESSAGES=60
# CHAT_RETENTION_DAYS=30             # saved chats auto-delete after this much inactivity
# CHAT_LIMIT_PER_USER=30 CHAT_LIMIT_GUEST_PER_IP=15 TICKET_LIMIT_PER_IP=5   # per 10 min / per hour

# Cookies. In production Secure is turned on automatically. Keep SameSite=lax when the frontend
# proxies /api (the default setup). Use none ONLY if the frontend calls the backend domain directly.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

HOME_VISIT_FEE=0
CANCELLATION_WINDOW_HOURS=12
RESCHEDULE_WINDOW_HOURS=2
REFUND_PERCENT=100

# Admin accounts are NEVER created by seeding and there is no default password. Provision explicitly:
#   ADMIN_PROVISION_EMAIL=you@example.com ADMIN_PROVISION_PASSWORD='a-long-unique-passphrase' \
#     node scripts/provisionAdmin.js            (add --confirm-production against production)
# Pass these only on the command line for that one run; never store them in .env or in Vercel.
# Catalogue seeding in production additionally requires ALLOW_PRODUCTION_SEED=yes.
