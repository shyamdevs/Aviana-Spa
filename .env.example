# Aviana Frontend Environment (Vite)
# Leave VITE_API_URL as /api. In production vercel.json proxies /api to the backend, and in
# development vite.config.js proxies /api to http://localhost:5000. Only change it if you
# deliberately call a backend on another domain (then also read the cookie notes in DEPLOY_GUIDE.md).
VITE_API_URL=/api
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_GOOGLE_CLIENT_ID=
